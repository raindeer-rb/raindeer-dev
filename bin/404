#!/usr/bin/env ruby
# frozen_string_literal: true

# Moves the exported "/404" page to "build/404.html". Run after "rain build".
# Cloudflare Pages serves a top-level "404.html" with a 404 status for missing pages.
# Without one it serves the home page with a 200, so every broken link looks like a working page.

require 'fileutils'

build_path = File.expand_path('../build', __dir__)
FileUtils.mv(File.join(build_path, '404', 'index.html'), File.join(build_path, '404.html'))
FileUtils.rmdir(File.join(build_path, '404'))
