#!/usr/bin/env ruby

# Call "rain" to use the CLI on your $PATH installed by Bundler.
# Call "bin/rain" to load gems locally from your Gemfile in dev.

require 'bundler/setup'
require 'raindeer/cli'

building = ARGV.first == 'build'

# "public" is copied into "build", but the CSS/JS bundles are gitignored and otherwise only built when the server boots.
if building
  require_relative '../config/assets'
  Assets.build
end

Rain::CLI.run(ARGV)

# Cloudflare Pages serves a top-level "404.html" with a 404 status for missing pages.
# Without one it serves the home page with a 200, so move the exported "/404" page there.
if building
  require 'fileutils'

  build_path = File.expand_path('build', Dir.pwd)
  FileUtils.mv(File.join(build_path, '404', 'index.html'), File.join(build_path, '404.html'))
  FileUtils.rmdir(File.join(build_path, '404'))
end
