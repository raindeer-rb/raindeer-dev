#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes "build/sitemap.xml" from the exported pages so search engines can find every docs page. Run after "rain build".

require 'erb'

SITE_URL = 'https://raindeer.dev'

build_path = File.expand_path('../build', __dir__)
paths = Dir.glob('**/index.html', base: build_path).map { |file| File.dirname(file) == '.' ? '/' : "/#{File.dirname(file)}" }

urls = paths.sort.map { |path| "  <url><loc>#{ERB::Util.html_escape(SITE_URL + path)}</loc></url>" }

File.write(File.join(build_path, 'sitemap.xml'), <<~XML)
  <?xml version="1.0" encoding="UTF-8"?>
  <urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  #{urls.join("\n")}
  </urlset>
XML
